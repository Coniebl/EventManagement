# Supabase Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-side signing secrets (use 32+ random characters in production)
SESSION_SECRET=replace-with-long-random-session-secret
QR_HMAC_SECRET=replace-with-long-random-qr-hmac-secret

# Public application URL (used in email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Email Sandbox (Level 3)
# Option A: Resend API
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=EventFlow <onboarding@resend.dev>

# Option B: SMTP (Mailtrap / Ethereal)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# Option C: Zero-config Ethereal test inbox (set to true for instant preview links)
USE_ETHEREAL_SANDBOX=true
